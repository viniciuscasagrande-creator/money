# Usar no gerenciador de segredos ou .env do host. Este exemplo não é carregado automaticamente.
# Endpoint receptor compatível com o contrato descrito no guia do pacote 7.
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_TOKEN=
MONITOR_ENVIRONMENT=money
MONITOR_QUEUE_MINUTES=30
MONITOR_ACCOUNTING_MINUTES=1440
MONITOR_WORKER_MINUTES=15
MONITOR_BACKUP_HOURS=26
# Ativar após configurar as rotinas reais; 0 aparece explicitamente como verificação desativada.
MONITOR_WORKER_REQUIRED=0
MONITOR_BACKUP_REQUIRED=0
