# Copiar configurações para .env ou fornecer pelo gerenciador de segredos do host.
# Gerar uma vez: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guardar chave fora dos backups, com recuperação documentada. Não publicar no Git.
BACKUP_ENCRYPTION_KEY=
# Diretório absoluto já montado e existente, fora deste projeto.
# Exemplo Windows: Z:/money-backups ; Linux: /mnt/backup-remoto/money
BACKUP_EXTERNAL_DIR=
BACKUP_KEEP=14
