# Copiar configurações para .env ou fornecer pelo gerenciador de segredos do host.
# Gerar uma vez: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guardar chave em cofre de senhas e cópia offline fora do computador e fora dos discos de backup. Não publicar no Git.
BACKUP_ENCRYPTION_KEY=
# Chaves anteriores separadas por vírgula para leitura de backups históricos após rotação de chave:
BACKUP_PREVIOUS_KEYS=
# Diretório absoluto já montado e existente, fora deste projeto (ex.: Z:/money-backups ; Linux: /mnt/backup-remoto/money)
BACKUP_EXTERNAL_DIR=
# Terceiro diretório absoluto independente com histórico de versões (ex.: volume de arquivo/nuvem separado)
BACKUP_ARCHIVE_DIR=
BACKUP_KEEP=14
BACKUP_MIN_FREE_BYTES=104857600
MONITOR_REHEARSAL_HOURS=168
