{
  "name": "erp-financeiro-fintech-premium",
  "version": "5.2.1",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-prisma.mjs",
    "dev": "next dev",
    "build": "node scripts/deploy-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:generate:pg": "prisma generate --schema=prisma/postgresql/schema.prisma",
    "db:push:pg": "prisma db push --schema=prisma/postgresql/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:homologacao": "node scripts/homologacao-integrada.mjs",
    "test:homologacao:pg": "node scripts/homologacao-postgres.mjs",
    "test:static": "node scripts/validacao-estatica.mjs",
    "test:unit:isolado": "node scripts/testes-sem-dependencias.mjs",
    "test:ui:static": "node scripts/verificar-ui-rotas.mjs",
    "deploy:build": "node scripts/deploy-build.mjs",
    "vercel-build": "node scripts/deploy-build.mjs",
    "backup": "tsx scripts/backup-geral.ts",
    "db:migrate:legacy": "tsx scripts/migrate-legacy-finance.ts",
    "backup:restore": "tsx scripts/restore-backup.ts",
    "test:regression": "tsx --test tests/integration-regressions.test.ts",
    "test:http": "node scripts/run-http-homologation.mjs",
    "backup:verify": "tsx scripts/verify-restoration.ts"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "postcss": "^8.5.3",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
